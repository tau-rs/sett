{
  "$schema": "vscode://schemas/color-theme",
  "name": "sett dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1B2429",
    "editor.foreground": "#E6EDF0",
    "editorGutter.background": "#1B2429",
    "editorLineNumber.foreground": "#8F9FA8",
    "editorLineNumber.activeForeground": "#B3C0C7",
    "editorCursor.foreground": "#E6EDF0",
    "editorWhitespace.foreground": "#28353D",
    "editorRuler.foreground": "#28353D",
    "editor.lineHighlightBackground": "#22303A",
    "editor.selectionBackground": "#1E3350",
    "editor.inactiveSelectionBackground": "#1E3350",
    "editor.wordHighlightBackground": "#28353D",
    "editor.wordHighlightStrongBackground": "#28353D",
    "editor.selectionHighlightBackground": "#28353D",
    "editor.findMatchBackground": "#3D3116",
    "editor.findMatchHighlightBackground": "#3D3116",
    "editorIndentGuide.background": "#28353D",
    "editorIndentGuide.activeBackground": "#33434C",
    "editorIndentGuide.background1": "#28353D",
    "editorIndentGuide.activeBackground1": "#33434C",
    "editorBracketMatch.border": "#33434C",
    "editorBracketMatch.background": "#28353D",
    "editorError.foreground": "#EB7065",
    "editorWarning.foreground": "#E0A63A",
    "editorInfo.foreground": "#629DE8",
    "editorHint.foreground": "#629DE8",
    "editorInlayHint.background": "#22303A",
    "editorInlayHint.foreground": "#8F9FA8",
    "editorInlayHint.typeBackground": "#22303A",
    "editorInlayHint.typeForeground": "#8F9FA8",
    "editorInlayHint.parameterBackground": "#22303A",
    "editorInlayHint.parameterForeground": "#8F9FA8",
    "editorGutter.modifiedBackground": "#629DE8",
    "editorGutter.addedBackground": "#4DB388",
    "editorGutter.deletedBackground": "#EB7065",
    "diffEditor.insertedTextBackground": "#1D3A2E",
    "diffEditor.removedTextBackground": "#45231F",
    "diffEditor.insertedLineBackground": "#1D3A2E",
    "diffEditor.removedLineBackground": "#45231F",
    "editorOverviewRuler.errorForeground": "#EB7065",
    "editorOverviewRuler.warningForeground": "#E0A63A",
    "editorOverviewRuler.infoForeground": "#629DE8",
    "editorOverviewRuler.modifiedForeground": "#629DE8",
    "editorOverviewRuler.addedForeground": "#4DB388",
    "editorOverviewRuler.deletedForeground": "#EB7065",
    "editorOverviewRuler.findMatchForeground": "#E0A63A",
    "editorOverviewRuler.selectionHighlightForeground": "#629DE8",
    "editorOverviewRuler.wordHighlightForeground": "#33434C",
    "editorOverviewRuler.bracketMatchForeground": "#33434C",
    "editorOverviewRuler.border": "#28353D",
    "editorLink.activeForeground": "#629DE8",
    "editorCodeLens.foreground": "#8F9FA8",
    "editorLightBulb.foreground": "#E0A63A",
    "editorGhostText.foreground": "#8F9FA8",
    "activityBar.background": "#22303A",
    "activityBar.foreground": "#E6EDF0",
    "activityBar.inactiveForeground": "#B3C0C7",
    "activityBar.border": "#28353D",
    "activityBar.activeBackground": "#1B2429",
    "activityBar.activeBorder": "#629DE8",
    "activityBar.activeFocusBorder": "#629DE8",
    "activityBarBadge.background": "#E0A63A",
    "activityBarBadge.foreground": "#1B2429",
    "sideBar.background": "#1B2429",
    "sideBar.foreground": "#B3C0C7",
    "sideBarSectionHeader.background": "#22303A",
    "sideBarSectionHeader.foreground": "#B3C0C7",
    "sideBarSectionHeader.border": "#28353D",
    "editorGroupHeader.tabsBackground": "#22303A",
    "editorGroupHeader.tabsBorder": "#28353D",
    "tab.border": "#28353D",
    "tab.activeBackground": "#1B2429",
    "tab.activeForeground": "#E6EDF0",
    "tab.activeBorderTop": "#629DE8",
    "tab.inactiveBackground": "#22303A",
    "tab.inactiveForeground": "#B3C0C7",
    "tab.unfocusedActiveBackground": "#1B2429",
    "tab.unfocusedActiveForeground": "#E6EDF0",
    "tab.unfocusedActiveBorderTop": "#629DE8",
    "tab.unfocusedInactiveForeground": "#B3C0C7",
    "statusBar.background": "#141B1F",
    "statusBar.foreground": "#B3C0C7",
    "statusBar.border": "#28353D",
    "statusBar.noFolderBackground": "#141B1F",
    "statusBar.noFolderForeground": "#B3C0C7",
    "statusBar.noFolderBorder": "#28353D",
    "statusBarItem.hoverBackground": "#22303A",
    "statusBarItem.hoverForeground": "#E6EDF0",
    "statusBarItem.focusBorder": "#629DE8",
    "statusBarItem.errorBackground": "#45231F",
    "statusBarItem.errorForeground": "#EB7065",
    "statusBarItem.warningBackground": "#3D3116",
    "statusBarItem.warningForeground": "#E0A63A",
    "statusBarItem.remoteBackground": "#1E3350",
    "statusBarItem.remoteForeground": "#BFD8F7",
    "panel.background": "#1B2429",
    "panel.border": "#33434C",
    "panelTitle.activeForeground": "#E6EDF0",
    "panelTitle.inactiveForeground": "#B3C0C7",
    "panelTitle.activeBorder": "#629DE8",
    "panelInput.border": "#33434C",
    "titleBar.activeBackground": "#1B2429",
    "titleBar.activeForeground": "#E6EDF0",
    "titleBar.inactiveBackground": "#1B2429",
    "titleBar.inactiveForeground": "#B3C0C7",
    "titleBar.border": "#28353D",
    "menu.background": "#1B2429",
    "menu.foreground": "#E6EDF0",
    "menu.border": "#33434C",
    "menu.selectionBackground": "#22303A",
    "menu.selectionForeground": "#E6EDF0",
    "menu.separatorBackground": "#28353D",
    "menubar.selectionBackground": "#22303A",
    "menubar.selectionForeground": "#E6EDF0"
  },
  "tokenColors": [
    {
      "name": "sett keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#79B5F1"
      }
    },
    {
      "name": "sett string",
      "scope": [
        "string",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7DBF8F"
      }
    },
    {
      "name": "sett constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#DAA773"
      }
    },
    {
      "name": "sett type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.union",
        "entity.other.inherited-class",
        "support.type",
        "storage.type.primitive",
        "entity.name.lifetime"
      ],
      "settings": {
        "foreground": "#38C2CB"
      }
    },
    {
      "name": "sett function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#EA98BD"
      }
    },
    {
      "name": "sett macro",
      "scope": [
        "entity.name.function.macro",
        "entity.name.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#E8A07F"
      }
    },
    {
      "name": "sett attribute",
      "scope": [
        "meta.attribute",
        "meta.attribute entity.name.type",
        "meta.attribute entity.name.function",
        "meta.attribute punctuation",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#46BEE5"
      }
    },
    {
      "name": "sett comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F9FA8"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#79B5F1",
    "selfKeyword": "#79B5F1",
    "selfTypeKeyword": "#79B5F1",
    "operator.controlFlow": "#79B5F1",
    "*.declaration": "#79B5F1",
    "string": "#7DBF8F",
    "character": "#7DBF8F",
    "escapeSequence": "#7DBF8F",
    "formatSpecifier": "#7DBF8F",
    "number": "#DAA773",
    "boolean": "#DAA773",
    "enumMember": "#DAA773",
    "variable.constant": "#DAA773",
    "variable.static": "#DAA773",
    "type": "#38C2CB",
    "class": "#38C2CB",
    "struct": "#38C2CB",
    "enum": "#38C2CB",
    "interface": "#38C2CB",
    "union": "#38C2CB",
    "typeAlias": "#38C2CB",
    "typeParameter": "#38C2CB",
    "builtinType": "#38C2CB",
    "lifetime": "#38C2CB",
    "function": "#EA98BD",
    "method": "#EA98BD",
    "macro": "#E8A07F",
    "macroBang": "#E8A07F",
    "derive": "#E8A07F",
    "deriveHelper": "#E8A07F",
    "procMacro": "#E8A07F",
    "attribute": "#46BEE5",
    "attributeBracket": "#46BEE5",
    "builtinAttribute": "#46BEE5",
    "decorator": "#46BEE5",
    "toolModule": "#46BEE5",
    "comment": "#8F9FA8"
  }
}
