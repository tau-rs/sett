/* generated by @tau-rs/sett-tokens from src/*.json. Edit the JSON, not this file. */
:root {
  --sett-font-sans: "IBM Plex Sans", system-ui, sans-serif;
  --sett-font-mono: "IBM Plex Mono", ui-monospace, monospace;
  --sett-font-size-xs: 10.5px;
  --sett-font-size-sm: 11px;
  --sett-font-size-md: 11.5px;
  --sett-font-size-base: 12px;
  --sett-font-size-lg: 12.5px;
  --sett-font-size-xl: 13px;
  --sett-font-size-h: 14px;
  --sett-font-map-label: 10px;
  --sett-font-line-height-ui: 1.45;
  --sett-font-line-height-code: 1.65;
  --sett-font-weight-normal: 400;
  --sett-font-weight-medium: 500;
  --sett-font-weight-semibold: 600;
  --sett-space-1: 4px;
  --sett-space-2: 8px;
  --sett-space-3: 12px;
  --sett-space-4: 16px;
  --sett-space-5: 20px;
  --sett-space-6: 24px;
  --sett-radius-item: 3px;
  --sett-radius-chip: 4px;
  --sett-radius-card: 6px;
  --sett-radius-node: 8px;
  --sett-radius-pane: 10px;
  --sett-radius-pill: 10px;
  --sett-stroke-hair: 1px;
  --sett-stroke-lit: 1.6px;
  --sett-stroke-frame: 3px;
  --sett-size-pill: 16px;
  --sett-size-tag: 15px;
  --sett-pad-pill: 7px;
  --sett-pad-tag: 5px;
  --sett-motion-frame-rotate: 6s;
  --sett-motion-frame-pulse: 1.6s;
  --sett-motion-item-pulse: 700ms;
  --sett-motion-zoom: 220ms;
  --sett-motion-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  --sett-glyph-done: "✓";
  --sett-glyph-running: "●";
  --sett-glyph-paused: "⏸";
  --sett-glyph-stepped-in: "✋";
  --sett-glyph-deviation: "≠";
  --sett-glyph-asks: "!";
  --sett-glyph-pending: "·";
  --sett-glyph-finding: "⚠";
  --sett-glyph-you: "you";
  --sett-glyph-sep: "·";
  --sett-color-bg: #F3F5F6;
  --sett-color-paper: #FFFFFF;
  --sett-color-well: #E9EDEF;
  --sett-color-ink: #17242B;
  --sett-color-ink2: #4A5B64;
  --sett-color-mute: #8A9AA3;
  --sett-color-line: #CBD4D9;
  --sett-color-line2: #E1E7EA;
  --sett-color-sel: #1F5FA8;
  --sett-color-sel-bg: #E3EEFB;
  --sett-color-sel-ink: #0C447C;
  --sett-color-ok: #2E7D5B;
  --sett-color-ok-bg: #E3F2EA;
  --sett-color-bad: #B23A33;
  --sett-color-bad-bg: #FBE7E5;
  --sett-color-sug: #B87A0E;
  --sett-color-sug-bg: #FBF2DE;
  --sett-shadow: 0px 8px 24px 0px rgba(0, 0, 0, 0.12);
  --sett-map-paper: #F7F6F2;
  --sett-map-grid: #EEECE6;
  --sett-map-item: #F1EFE8;
  --sett-map-item-stroke: #888780;
  --sett-map-item-ink: #2C2C2A;
  --sett-map-area-stroke: #B4B2A9;
  --sett-map-area-ink: #5F5E5A;
  --sett-map-link: #888780;
  --sett-map-link-lit: #1F5FA8;
  --sett-map-external: #E7E5DE;
  --sett-map-faded-opacity: 0.3;
  --sett-session-yk-main: #6B5BD2;
  --sett-session-yk-sub: #9C8FE8;
  --sett-session-yk-bg: #EEEBFB;
  --sett-session-tl-main: #1D9E75;
  --sett-session-tl-sub: #5FC3A3;
  --sett-session-tl-bg: #E1F5EE;
  --sett-session-mg-main: #B8378F;
  --sett-session-mg-sub: #D57AB9;
  --sett-session-mg-bg: #F9E6F3;
  --sett-session-cy-main: #1B8FA6;
  --sett-session-cy-sub: #62B9CB;
  --sett-session-cy-bg: #E0F3F7;
  --sett-session-ol-main: #6E8B1E;
  --sett-session-ol-sub: #A3B95C;
  --sett-session-ol-bg: #EEF3DC;
  --sett-session-sn-main: #B0562B;
  --sett-session-sn-sub: #D28E6E;
  --sett-session-sn-bg: #F9EAE2;
