    "-c/--count",
    "-n/--line-number",
    "-C/--context NUM",
    "--json",
    "-j/--threads NUM",
    "--mmap",
    "-z/--search-zip",
    "--pre COMMAND",
    "-P/--pcre2",
    "--index (new)",
    "\u2026 90 more"
